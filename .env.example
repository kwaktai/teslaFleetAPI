# Tesla 개발자 포털(developer.tesla.com)에서 발급받은 값
TESLA_CLIENT_ID=여기에_클라이언트_ID
TESLA_CLIENT_SECRET=여기에_클라이언트_시크릿

# Tesla 개발자 앱에 등록한 공개 도메인 (https:// 제외, 예: mynas.synology.me)
TESLA_DOMAIN=mynas.synology.me

# 리전: na(북미·아시아태평양, 한국 포함) / eu(유럽·중동·아프리카) / cn(중국)
TESLA_REGION=na

# NAS에서 사용할 호스트 포트. DSM 역방향 프록시의 "대상 포트"와 같아야 합니다.
# 다른 서비스와 겹치지 않는 값으로 바꾸세요. (기본 8080)
HOST_PORT=8080
