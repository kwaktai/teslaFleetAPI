# Tesla 개발자 포털(developer.tesla.com)에서 발급받은 값
TESLA_CLIENT_ID=여기에_클라이언트_ID
TESLA_CLIENT_SECRET=여기에_클라이언트_시크릿

# Tesla 개발자 앱에 등록한 공개 도메인 (https:// 제외, 예: mynas.synology.me)
TESLA_DOMAIN=mynas.synology.me

# 리전: na(북미·아시아태평양, 한국 포함) / eu(유럽·중동·아프리카) / cn(중국)
TESLA_REGION=na

# NAS에서 사용할 호스트 포트. DSM 역방향 프록시의 "대상 포트"와 같아야 합니다.
# 다른 서비스와 겹치지 않는 값으로 바꾸세요. (기본 8080)
HOST_PORT=8080

# API 접근 키. 비워두면 첫 실행 시 자동 생성되어 data/api-key.txt 에 저장됩니다.
# 직접 정하려면 길고 무작위한 값을 넣으세요.
API_KEY=

# 명령 서명 프록시의 호스트 포트.
# 서버는 도커 내부 네트워크로 접근하므로 이 포트는 직접 확인·디버깅용입니다.
# 역방향 프록시나 공유기 포트포워딩을 이 포트에 연결하지 마세요.
PROXY_HOST_PORT=9102

# 차량 별칭 (선택). 짧은 이름으로 차량을 지정할 수 있습니다.
# 예: VEHICLE_ALIASES=3=5YJ3E1EB8LF727066,X=7SAXCBE66TF488989
#     -> /api/vehicles/3/command/door_lock
# 별칭을 지정하지 않아도 차량 이름(Tesla 앱에서 정한 이름)은 그대로 쓸 수 있습니다.
VEHICLE_ALIASES=

# 명령에 ?wake=1 을 붙였을 때 차량이 깨어나기를 기다리는 최대 시간(초). 기본 30
WAKE_TIMEOUT_SECONDS=30
